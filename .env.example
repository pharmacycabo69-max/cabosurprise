# Google tag (gtag.js) ID. Use your Google Ads tag, e.g. AW-1234567890
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for WhatsApp clicks (Google Ads > Goals > Conversions), e.g. AbCdEfGhIjK
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Meta Pixel ID (Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=
# Public site URL (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.cabosurprise.com

# Stripe secret key for deposit payments (server only, never expose). Use sk_test_... until you go live.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) for https://www.cabosurprise.com/api/stripe/webhook/ (keep the trailing slash)
STRIPE_WEBHOOK_SECRET=

# Exchange rate for venue deposits: pesos per 1 US dollar (e.g. 17.50). Required for /quote/ online payments.
MXN_PER_USD=

# Resend (transactional email for paid-deposit alerts and customer confirmations)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Cabo Surprise <bookings@cabosurprise.com>".
# Without it, mail is sent from onboarding@resend.dev, which Resend only delivers to your own account email.
EMAIL_FROM=
# Your inbox for "deposit received" alerts
NOTIFY_EMAIL=
